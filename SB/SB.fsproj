<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="CSharpRuntime\**\*">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="CRuntime\**\*">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Compile Include="Types.fs" />
        <Compile Include="HIR.fs" />
        <Compile Include="HIRPrettyPrinter.fs" />
        <Compile Include="HirCBackend.fs" />
        <Compile Include="HirCSharpBackend.fs" />
        <Compile Include="SyntaxAst.fs" />
        <Compile Include="Interpreter.fs" />
        <Compile Include="AstDiagnostics.fs" />
        <Compile Include="ProcessingTypes.fs" />
        <Compile Include="ScopeNames.fs" />
        <Compile Include="BuiltIns.fs" />
        <Compile Include="SymbolHelpers.fs" />
        <Compile Include="SymbolTableManager.fs" />
        <Compile Include="ParseTreeVisitor.fs" />
        <Compile Include="SemanticAnalysis.Facts.fs" />
        <Compile Include="SemanticAnalysis.Symbols.fs" />
        <Compile Include="SemanticAnalysis.Expressions.fs" />
        <Compile Include="SemanticAnalyzer.fs" />
        <Compile Include="TypeAnalyzer.fs" />
        <Compile Include="SSB.fs" />
        <Compile Include="AstToHir.fs" />
        <Compile Include="CompilerPipeline.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Antlr4.Runtime.Standard" Version="*" />
      <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" />
      <PackageReference Include="FSharpPlus" Version="1.9.1" />
      <PackageReference Include="FSharpx.Collections" Version="3.1.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="11.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
      <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />
      <PackageReference Include="StringTemplate4" Version="4.0.9-rc1" />
      <PackageReference Update="FSharp.Core" Version="11.0.101" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SB.CSharpRuntime\SB.CSharpRuntime.csproj" />
      <ProjectReference Include="..\SBLib\SBLib.csproj" />
      <ProjectReference Include="..\SBRuntime\SBRuntime.fsproj" />
      <ProjectReference Include="..\SB.AvaloniaHost\SB.AvaloniaHost.fsproj" />
    </ItemGroup>

</Project>
