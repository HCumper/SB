<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <IsTestProject>true</IsTestProject>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="ParseTreeVisitorTests.fs" />
        <Compile Include="AstToHirTests.fs" />
        <Compile Include="CompilerPipelineTests.fs" />
        <Compile Include="HirCBackendTests.fs" />
        <Compile Include="HirCSharpBackendTests.fs" />
        <Compile Include="UtilityTests.fs" />
        <Compile Include="AstVerificationTests.fs" />
        <Compile Include="AstDiagnosticsTests.fs" />
        <Compile Include="SemanticAnalyzerTests.fs" />
        <Compile Include="ProgramFixtureTests.fs" />
        <Compile Include="GeneratedCExecutionTests.fs" />
        <Compile Include="GeneratedCSharpExecutionTests.fs" />
        <Compile Include="PipelineSourceTests.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SB\SB.fsproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
      <PackageReference Include="NUnit" Version="5.0.0" />
      <PackageReference Include="NUnit3TestAdapter" Version="6.3.1">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Update="FSharp.Core" Version="11.0.101" />
    </ItemGroup>

</Project>
