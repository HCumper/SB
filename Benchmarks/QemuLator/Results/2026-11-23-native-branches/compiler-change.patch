+               not(writes.Writes.Contains counter) && not writes.LoopMetadataWritesUnknown && writes.LoopMetadataWrites.IsEmpty then
+                let names=roots.Add counter |> Set.filter(fun s -> not(effects.Aliases.ArrayStorages.Contains s))
