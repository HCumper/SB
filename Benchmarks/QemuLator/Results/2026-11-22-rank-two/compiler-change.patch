+let ``rank-two proven dimensions reduce checks without changing the result`` () =
+    let run mask=rankTwoExecute (allocation [op 106 [1];op 106 [2];op 1911 [30;mask;8];op 118 [20]]) 4 8 0x10000u 0x10014u false false
